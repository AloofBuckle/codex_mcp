+static int titlebar_control_at(struct sway_container *cont,
+		struct sway_cursor *cursor) {
+	if (!cont || !cont->view || cont->pending.border != B_NORMAL ||
+			cont->pending.fullscreen_mode != FULLSCREEN_NONE) {
+		return -1;
+	}
+	int height = container_titlebar_height();
+	int thickness = config->titlebar_border_thickness;
+	double left = cont->pending.x + cont->pending.width - thickness - height * 3;
+	double top = cont->pending.y;
+	double x = cursor->cursor->x;
+	double y = cursor->cursor->y;
+	if (x < left || x >= cont->pending.x + cont->pending.width - thickness ||
+			y < top || y >= top + height) {
+		return -1;
+	}
+	int control = (int)((x - left) / height);
+	return control >= 0 && control < 3 ? control : -1;
+}
+
+static void toggle_titlebar_maximize(struct sway_container *cont) {
+	struct sway_container *target = container_toplevel_ancestor(cont);
+	struct sway_workspace *ws = target->pending.workspace;
+	if (!ws || !container_is_floating(target)) {
+		return;
+	}
+	if (target->mcpbrowser_maximized) {
+		target->pending.x = target->mcpbrowser_saved_x;
+		target->pending.y = target->mcpbrowser_saved_y;
+		target->pending.width = target->mcpbrowser_saved_width;
+		target->pending.height = target->mcpbrowser_saved_height;
+		target->mcpbrowser_maximized = false;
+	} else {
+		target->mcpbrowser_saved_x = target->pending.x;
+		target->mcpbrowser_saved_y = target->pending.y;
+		target->mcpbrowser_saved_width = target->pending.width;
+		target->mcpbrowser_saved_height = target->pending.height;
+		target->pending.x = ws->x;
+		target->pending.y = ws->y;
+		target->pending.width = ws->width;
+		target->pending.height = ws->height;
+		target->mcpbrowser_maximized = true;
+	}
+	arrange_container(target);
+	transaction_commit_dirty();
+}
+
+static void handle_titlebar_control(struct sway_seat *seat,
+		struct sway_container *cont, int control) {
+	struct sway_container *target = container_toplevel_ancestor(cont);
+	seat_set_focus_container(seat, cont);
+	switch (control) {
+	case 0:
+		if (!target->scratchpad) {
+			root_scratchpad_add_container(target, NULL);
+		} else if (target->pending.workspace) {
+			root_scratchpad_hide(target);
+		}
+		break;
+	case 1:
+		toggle_titlebar_maximize(target);
+		break;
+	case 2:
+		if (cont->view) {
+			view_close(cont->view);
+		}
+		break;
+	}
+	transaction_commit_dirty();
+}
