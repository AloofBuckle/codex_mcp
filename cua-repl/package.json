{
  "name": "open-cua-mcpbrowser",
  "version": "0.1.1",
  "private": true,
  "files": [
    "src/",
    "public/",
    "extension/",
    "assets/",
    "types/",
    "config/defaults.yaml",
    "config/environment.yaml",
    "cua.config.example.yaml",
    "examples/*.yaml",
    "docs/",
    "test/",
    "test-fixtures-rs/",
    "acceptance/",
    "native/*.c",
    "native/wayland-protocols/",
    "native-live/",
    "control-rs/src/",
    "control-rs/Cargo.toml",
    "control-rs/Cargo.lock",
    "native-rs/src/",
    "native-rs/build.rs",
    "native-rs/Cargo.toml",
    "native-rs/Cargo.lock",
    "native-shell/*.c",
    "native-shell/*.cpp",
    "native-shell/*.svg",
    "native-shell/*.patch",
    "native-shell/*.css",
    "native-shell/*.qss",
    "native-shell/*.ini",
    "native-shell/*.conf",
    "native-shell/*.json",
    "native-shell/plasma-theme/",
    "native-rs/examples/",
    "native-rs/protocols/",
    "media-session/",
    "vendor/webrtc-sctp-0.13.0-patched/",
    "vendor/webrtc-0.14.0-patched/",
    "packaging/release.yaml",
    "package-lock.json",
    "LICENSE",
    ".node-version",
    ".nvmrc",
    "native-shell/dmabuf-capture/mcpbrowser-dmabuf-capture-v1.xml"
  ],
  "type": "module",
  "description": "CUA-compatible persistent REPL MCP and shared human/agent browser",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- serve",
    "mcp": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- mcp",
    "gui": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- serve",
    "test": "node --require ./test/bootstrap.cjs --test --test-concurrency=1 test/*.test.mjs",
    "test:all": "npm test && node acceptance/run.mjs",
    "test:acceptance": "node acceptance/run.mjs",
    "test:native": "node test/native-smoke.mjs",
    "test:native-live": "node test/native-live-smoke.mjs",
    "snapshot": "node test/snapshot.mjs",
    "native:build": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- native-build",
    "service:start": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- service-start",
    "service:stop": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- service-stop",
    "native:install": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- native-install",
    "config:check": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- check",
    "config:doctor": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- doctor",
    "deploy:render": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- deploy",
    "release:source": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- source-release",
    "release:pack": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- package --format all",
    "release:rpm": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- package --format rpm",
    "release:deb": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- package --format deb",
    "release:native:rpm": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- package-native --format rpm",
    "release:native:deb": "cargo run --quiet --manifest-path control-rs/Cargo.toml -- package-native --format deb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "acorn": "8.18.0",
    "marked": "18.0.13",
    "playwright": "1.63.0",
    "ws": "8.21.3",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "license": "Apache-2.0"
}
